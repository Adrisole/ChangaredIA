# ===============================================
# Configuración del Entorno - Changared
# ===============================================

# Puerto de escucha del servidor Express
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=development

# Clave de API de OpenAI (Obligatoria para respuestas con IA real)
# Si está vacía o sin fondos, el sistema activará un modo simulado inteligente para pruebas
OPENAI_API_KEY=sk-proj-tu_clave_de_openai_aqui

# Modelo de OpenAI a utilizar (Recomendado: gpt-4o-mini por velocidad y bajo costo)
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Business Platform / Meta Cloud API Oficial
# Obtenidos en Meta for Developers > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=changared_secret_verify_token_2026
WHATSAPP_ACCESS_TOKEN=EAAG...tu_token_de_acceso_permanente_de_meta
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_APP_SECRET=tu_app_secret_para_validar_firmas
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0

# Ruta del archivo JSON de almacenamiento multi-tenant (fallback local)
DATA_STORAGE_PATH=./src/data/businesses.json

# Conexión a MongoDB (MongoDB Atlas o local)
# Si se provee, los negocios, usuarios, sesiones, conversaciones, turnos y comprobantes se guardarán en MongoDB
# Ejemplo: mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/changared?retryWrites=true&w=majority
MONGODB_URI=

# ===============================================
# PAGOS Y COBROS DE SUSCRIPCIONES (Changared)
# ===============================================
# - Comercios en LATAM (moneda local) -> Mercado Pago (checkout automatico + webhook)
# - Clientes internacionales (USD) -> Wise / Payoneer (link o transferencia, confirmacion manual)

# URL publica HTTPS del backend. Se usa para el webhook y las back_urls de Mercado Pago.
# Ej: https://app.changared.com
PUBLIC_BASE_URL=

# Clave secreta propia para confirmar pagos Wise/Payoneer: POST /api/billing/confirm-manual
# con header "x-admin-key". Genera una larga: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BILLING_ADMIN_KEY=

# --- Mercado Pago LATAM (moneda local de cada pais) ---
# Mercado Pago opera con una cuenta/aplicacion DISTINTA por pais: AR, BR, MX, CL, CO, PE, UY.
# Configura solo los paises donde tengas cuenta; los demas quedan deshabilitados en el panel.
# Credenciales: https://www.mercadopago.com.ar/developers/panel/app (cambia el dominio .com.br/.com.mx/.cl/.com.co/.com.pe/.com.uy)
#   > Tu app > Credenciales de produccion > Access Token
# Clave de firma de webhooks: Tu app > Webhooks > Configurar notificaciones > Clave secreta
# URL a registrar en cada app (evento "Pagos"): {PUBLIC_BASE_URL}/api/billing/webhook/mercadopago?country=<PAIS>
MP_DEFAULT_COUNTRY=AR

# Argentina (ARS) - usa los precios fijos en pesos del plan. (MP_ACCESS_TOKEN tambien es valido para AR)
MP_ACCESS_TOKEN_AR=
MP_WEBHOOK_SECRET_AR=

# Resto de LATAM: precio = precio USD del plan x MP_FX_<MONEDA> (moneda local por 1 USD). Actualizalo periodicamente.
MP_ACCESS_TOKEN_BR=
MP_WEBHOOK_SECRET_BR=
MP_FX_BRL=
MP_ACCESS_TOKEN_MX=
MP_WEBHOOK_SECRET_MX=
MP_FX_MXN=
MP_ACCESS_TOKEN_CL=
MP_WEBHOOK_SECRET_CL=
MP_FX_CLP=
MP_ACCESS_TOKEN_CO=
MP_WEBHOOK_SECRET_CO=
MP_FX_COP=
MP_ACCESS_TOKEN_PE=
MP_WEBHOOK_SECRET_PE=
MP_FX_PEN=
MP_ACCESS_TOKEN_UY=
MP_WEBHOOK_SECRET_UY=
MP_FX_UYU=

# --- Wise (USD) ---
# Link de cobro: Wise > Recibir > "Pedir pago / Pay me link" (https://wise.com/pay/me/tunombre)
WISE_PAYMENT_LINK=
WISE_ACCOUNT_HOLDER=
# Email de tu cuenta Wise (para transferencias Wise a Wise, comision 0)
WISE_EMAIL=
# Datos bancarios USD de Wise (ACH). Una sola linea, ej: "Routing 026073150 | Cuenta 8310000000 | Wise US Inc"
WISE_USD_ACCOUNT_DETAILS=

# --- Payoneer (USD) ---
# Link: Payoneer > Recibir > Solicitud de pago
PAYONEER_PAYMENT_LINK=
PAYONEER_EMAIL=
PAYONEER_ACCOUNT_HOLDER=
