# ===============================================
# Configuración del Entorno - Changared
# ===============================================

# Puerto de escucha del servidor Express
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=development

# Clave de API de OpenAI (Obligatoria para respuestas con IA real)
# Si está vacía o sin fondos, el sistema activará un modo simulado inteligente para pruebas
OPENAI_API_KEY=sk-proj-tu_clave_de_openai_aqui

# Modelo de OpenAI a utilizar (Recomendado: gpt-4o-mini por velocidad y bajo costo)
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Business Platform / Meta Cloud API Oficial
# Obtenidos en Meta for Developers > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=changared_secret_verify_token_2026
WHATSAPP_ACCESS_TOKEN=EAAG...tu_token_de_acceso_permanente_de_meta
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_APP_SECRET=tu_app_secret_para_validar_firmas
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0

# Ruta del archivo JSON de almacenamiento multi-tenant (fallback local)
DATA_STORAGE_PATH=./src/data/businesses.json

# Conexión a MongoDB (MongoDB Atlas o local)
# Si se provee, los negocios, usuarios, sesiones y comprobantes se guardarán en MongoDB
# Ejemplo: mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/changared?retryWrites=true&w=majority
MONGODB_URI=
